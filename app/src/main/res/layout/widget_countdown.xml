<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:gravity="center_vertical" android:orientation="vertical" android:padding="14dp">
    <TextView android:id="@+id/w_detail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A7B1C5" android:textSize="12sp" />
    <TextView android:id="@+id/w_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F7F8FC" android:textSize="34sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#58B5FF" android:textSize="13sp" />
</LinearLayout>
